# Copy to .env.docker and replace BOTH secrets before starting Docker.
# Windows: scripts/configure-docker.ps1 generates these values for you.
# Use a long hexadecimal PostgreSQL password; it is also used in a database URL.
POSTGRES_PASSWORD=
JWT_SECRET=
DEMO_MODE=false
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Keep the Docker API separate from the native development API on port 8000.
CIVIC_API_PORT=8001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Provider settings are forwarded into the backend container.
VISION_PROVIDER=openai
VISION_MODEL=
VISION_API_KEY=
VISION_ENDPOINT=
VISION_FALLBACK_PROVIDER=
VISION_FALLBACK_MODEL=
VISION_FALLBACK_API_KEY=
VISION_FALLBACK_ENDPOINT=
VISION_TIMEOUT_SECONDS=40
# For an installed host Ollama server use VISION_PROVIDER=ollama and its model.
# The host server must allow connections from the Docker network.
OLLAMA_ENDPOINT=http://host.docker.internal:11434/api/generate
OLLAMA_MODEL=

DATABASE_URL=postgresql+psycopg2://civicshield:CHANGE_ME@127.0.0.1:5432/civicshield
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
DEMO_MODE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# See docs/vision-providers.md. Native Ollama: provider=ollama, installed model
# name, endpoint=http://127.0.0.1:11434/api/generate (no cloud key required).
VISION_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash
VISION_MODEL=
VISION_API_KEY=
VISION_ENDPOINT=
VISION_FALLBACK_PROVIDER=
VISION_FALLBACK_MODEL=
VISION_FALLBACK_API_KEY=
VISION_FALLBACK_ENDPOINT=
VISION_TIMEOUT_SECONDS=40
# Provider-specific aliases GEMINI_API_KEY, ANTHROPIC_API_KEY, HF_TOKEN,
# COMPATIBLE_API_KEY, OLLAMA_MODEL are also supported. Never put keys in VITE_*.
WEATHER_REFRESH_MINUTES=30
# Set UPLOAD_DIR to a durable volume in production.
# UPLOAD_DIR=/data/uploads
